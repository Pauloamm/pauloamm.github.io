---
interface Props {
  id: string;
  title?: string;
}
const { id, title = "Video" } = Astro.props;
---

<div class="w-full aspect-video rounded-lg sm:rounded-xl overflow-hidden my-6 sm:my-8">
  <iframe
    class="w-full h-full"
    src={`https://www.youtube.com/embed/${id}`}
    title={title}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  />
</div>
