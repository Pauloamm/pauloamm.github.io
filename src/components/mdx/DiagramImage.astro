---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  maxWidthClass?: string;
}
const { src, alt, caption, maxWidthClass = "" } = Astro.props;
---

<figure class="mb-6">
  <div class={`${maxWidthClass} mx-auto`}>
    <Image src={src} alt={alt} class="w-full h-auto invert" />
  </div>
  {caption && (
    <figcaption class="text-sm text-[var(--color-text-subtle)] mt-2 text-center">{caption}</figcaption>
  )}
</figure>