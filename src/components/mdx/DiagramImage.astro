---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="mb-6">
  <Image src={src} alt={alt} class="w-full h-auto invert" />
  {caption && (
    <figcaption class="text-sm text-gray-400 mt-2 text-center">{caption}</figcaption>
  )}
</figure>