---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";

const hasGamejams = siteConfig.projects?.some((p) => p.category === "gamejam");
const hasProjects = siteConfig.projects?.some((p) => (p.category ?? "personal") === "personal");
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<footer class="relative bg-[var(--color-bg)] border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold text-[var(--color-text)]">{siteConfig.name}</h3>
        <p class="text-base text-[var(--color-text-muted)]">{siteConfig.title}</p>
        <SocialLinks iconClass="h-6 w-6" textClass="text-[var(--color-text-muted)]" />
      </div>

      <div class="hidden md:block flex flex-col md:items-end gap-4">
        <nav class="flex gap-x-8">
          <a href="/#about" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">About</a>
          {hasGamejams && <a href="/#gamejams" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">GameJams</a>}
          {hasProjects && <a href="/#projects" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">Projects</a>}
          {hasExperience && <a href="/#experience" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">Experience</a>}
          {hasEducation && <a href="/#education" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">Education</a>}
        </nav>
        <p class="text-sm text-[var(--color-text-subtle)]">
          © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
        </p>
      </div>
    </div>
  </div>

  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg aria-hidden="true" class="absolute bottom-0 left-0 w-full h-24 text-[var(--color-border)]">
      <pattern id="footer-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
        <path d="M0 50 Q 25 40, 50 50 T 100 50" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.4"></path>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
    </svg>
  </div>
</footer>